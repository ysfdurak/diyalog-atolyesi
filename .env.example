# Diyalog Atölyesi ayarları. Bu dosyayı .env olarak kopyala; .env GitHub'a GÖNDERİLMEZ.
# Ayrıntı: docs/SUNUCU_KURULUMU.md

# --- Adres -------------------------------------------------------------------
APP_URL=https://diyalog.ysfdurak.com/
PORT=8080
DATA_DIR=/data

# --- Yapay zekâ (Anthropic API) ----------------------------------------------
# Anahtar: console.anthropic.com → API Keys. Parola gibidir: kimseyle paylaşma, GitHub'a koyma.
# Console'da aylık harcama limiti koymayı unutma (ör. 10 $); kodda hata olsa bile fatura bu sınırı geçmez.
ANTHROPIC_API_KEY=
# anthropic: gerçek model · mock: yapay zekâsız deneme (karakter basit kurallarla cevap verir, anahtar gerekmez)
MODEL_MODE=anthropic
# Karakter hızlı ve ucuz modelle çalışır. Rapor kalitesi yetmezse yalnızca değerlendiriciyi yükselt: claude-sonnet-5-5
KARAKTER_MODELI=claude-haiku-5-5
DEGERLENDIRICI_MODELI=claude-haiku-5-5

# --- Kullanım limitleri (maliyetin üst sınırı) -------------------------------
# Bir oturum en fazla 6 model çağrısı yapar (5 soru + 1 değerlendirme).
ZIYARETCI_GUNLUK_OTURUM=3
SITE_GUNLUK_OTURUM=30

# --- MCP kapısı: Claude ve diğer yapay zekâ istemcileri (docs/MCP.md) ---------
# Varsayılan kapalı. Açmak için en az bir anahtar gerekir (üretmek için: openssl rand -hex 32).
MCP_ENABLED=false
MCP_ANAHTARLARI=
MCP_GUNLUK_OTURUM=10
